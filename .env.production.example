# AFARM — production (AWS). Copy to `.env.production` before `npm run build`.
# NEXT_PUBLIC_* values are baked into the client at build time.

# Public API origin (no /api/v1 suffix on this one)
NEXT_PUBLIC_API_URL=https://api.afarm.khulega.online
NEXT_PUBLIC_API_BASE=https://api.afarm.khulega.online/api/v1

NEXT_PUBLIC_SITE_NAME=AFARM
NEXT_PUBLIC_SITE_URL=https://afarm.khulega.online
NEXT_PUBLIC_INSTAGRAM_URL=
# Same as backend AWS_CLOUDFRONT_URL when using S3 (optional; API returns full image URLs)
NEXT_PUBLIC_CDN_URL=https://dxxxxxxxx.cloudfront.net

NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_PAYU_KEY=

# Next.js server components: call API on localhost (same EC2), not through the public URL
API_INTERNAL_BASE=http://127.0.0.1:8100/api/v1